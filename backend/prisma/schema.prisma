generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  createdAt DateTime @default(now())
  loans     Loan[]
}

model Loan {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  friendName String
  amount     Float
  dueDate    DateTime
  isRepaid   Boolean  @default(false)
  createdAt  DateTime @default(now())
}